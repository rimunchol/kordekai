# ---- Required ----
# Server-side only. Never prefix with NEXT_PUBLIC_.
NAVY_API_KEY=sk-navy-Ck8irWKJpbR1V7dGhlzodcckCXbf2sfkQwQHtzDvvNY
# Any Postgres connection string (Neon / Supabase / Vercel Postgres). Use the pooled URL on Vercel.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Long random string (>= 32 chars). Used to HMAC session tokens and stored IP hashes.
#   openssl rand -base64 48
AUTH_SECRET=A3k8Lm9Pq2Rt5Uw7Yz0Bc4Df6Gh1Jk3
# Username of the developer/admin account. Reserved: it can't be self-registered.
# Create the account once with:  ADMIN_PASSWORD='09876543' npm run admin:create
DEVELOPER_USERNAME=kordek

# ---- Optional ----
# Default model (can be changed later from the developer dashboard).
NAVY_MODEL=gpt-4.1
NAVY_BASE_URL=https://api.navy/v1

# Managed rate limiting (recommended on Vercel). Without these, a Postgres-backed
# limiter is used instead. Vercel's Upstash integration may provide KV_REST_API_* names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Trust x-real-ip / x-forwarded-for for client IPs. Automatic on Vercel (VERCEL=1).
# Only set to "true" elsewhere if you are behind a proxy that overwrites these headers.
TRUST_PROXY=

